{
  "name": "daemonbot",
  "version": "1.0.0",
  "description": "General-purpose Discord bot: moderation, embeds, announcements",
  "type": "module",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
    "check": "node --check src/index.js",
    "sweep": "node scripts/sweep.js",
    "lavalink": "cd lavalink && java -jar Lavalink.jar",
    "panel": "node scripts/serve-panel.js",
    "panel:api": "npm --prefix worker run dev"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "lavalink-client": "^2.11.0"
  }
}
