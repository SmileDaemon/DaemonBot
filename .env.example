# Copy this file to .env and fill in the values. Never share or commit .env.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID: Developer Portal -> your app -> General Information
CLIENT_ID=

# Optional: a server ID to register commands to instantly while testing.
# Leave blank to register globally (all servers; can take up to an hour the first time).
DEV_GUILD_ID=

# Deletes messages containing anything listed in filter-words.txt. Toggle per server with /config filter.
# Requires turning on "Message Content Intent" in Developer Portal -> Bot.
ENABLE_WORD_FILTER=true

# Optional: when someone posts a link to a Discord message, the bot quotes it as an embed.
# Also requires "Message Content Intent".
ENABLE_MESSAGE_QUOTES=false

# Logs member, message, invite, channel, role, server-setting, emoji/sticker, webhook and AutoMod events
# to the /config log channel (see README for the full list).
# Requires "Server Members Intent" AND "Message Content Intent" in Developer Portal -> Bot.
ENABLE_SERVER_LOGS=true

# Records which games members play, for how long and how often. Shown only in the control panel;
# toggle per server there.
# Requires turning on "Presence Intent" in Developer Portal -> Bot.
ENABLE_GAME_TRACKING=true

# Records time each member spends in voice channels, which server they're in, and who they were in
# them with. Shown only in the control panel; toggle per server there. Needs "Server Members Intent".
ENABLE_VOICE_TRACKING=true

# Records how active each member is in each server: messages, reactions, active days (and voice time,
# with voice tracking). Shown only in the control panel; toggle per server there. Needs "Server Members Intent".
ENABLE_ACTIVITY_TRACKING=true

# Works out who is connected to whom (replies, mentions, reactions to each other, chatting back and forth,
# plus voice time and games played together when those trackers are on) and the groups members form.
# Shown only in the control panel; toggle per server there. Needs "Server Members Intent".
ENABLE_CONNECTION_TRACKING=true

# Music via a Lavalink audio server. SHELVED: /play and /music aren't registered (their code is in
# src/music/commands/) until music is finished, so leave this off. See README -> Music.
ENABLE_MUSIC=false
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
# Must match lavalink.server.password in lavalink/application.yml
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Default embed color (hex) used when none is given
DEFAULT_EMBED_COLOR=#5865F2

# Control panel (see MAINTAINING.md -> "Control panel"). Leave blank to run without it.
# PANEL_URL is your Cloudflare Worker's address, e.g. https://daemonbot-panel.yourname.workers.dev
PANEL_URL=
# Must match the worker's BOT_SECRET (set with: npx wrangler secret put BOT_SECRET)
PANEL_SECRET=
